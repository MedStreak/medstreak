rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a real, verified account (never anonymous).
    function authed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isMe(u) { return authed() && request.auth.uid == u; }
    function str(v, n) { return v is string && v.size() <= n; }

    // The creator's account id lives in config/creator, which can only be edited in the Firebase console.
    function isCreator() {
      return authed()
        && exists(/databases/$(database)/documents/config/creator)
        && get(/databases/$(database)/documents/config/creator).data.uid == request.auth.uid;
    }

    match /config/{doc} {
      allow read: if authed();
      allow write: if false;
    }

    // Kept so existing accounts stay linked to one key.
    match /emailOwners/{email} {
      allow read: if authed();
      allow create: if authed() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
    }
    match /members/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid);
    }

    function favOk(f) {
      return f is map && f.keys().hasOnly(['song','artist','show','game','snack','comfort','place','fun'])
        && str(f.get('song',''),60) && str(f.get('artist',''),60) && str(f.get('show',''),60)
        && str(f.get('game',''),60) && str(f.get('snack',''),60) && str(f.get('comfort',''),60)
        && str(f.get('place',''),60) && str(f.get('fun',''),60);
    }
    function tagsOk(l) { return l is list && l.size() <= 8; }

    match /profiles/{uid} {
      allow read: if authed();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name','about','link','pronouns','mood','sticker','color','cardStyle','shape','interests','music','fav','streak','best','thumb','updatedAt'])
        && str(request.resource.data.name, 30) && request.resource.data.name.size() >= 1
        && str(request.resource.data.get('about',''), 240)
        && str(request.resource.data.get('link',''), 200)
        && str(request.resource.data.get('pronouns',''), 20)
        && str(request.resource.data.get('mood',''), 12)
        && str(request.resource.data.get('sticker',''), 8)
        && str(request.resource.data.get('color',''), 7)
        && str(request.resource.data.get('cardStyle',''), 10)
        && str(request.resource.data.get('shape',''), 10)
        && str(request.resource.data.get('thumb',''), 8000)
        && tagsOk(request.resource.data.get('interests',[]))
        && tagsOk(request.resource.data.get('music',[]))
        && favOk(request.resource.data.get('fav',{}))
        && request.resource.data.get('streak',0) is int
        && request.resource.data.get('best',0) is int;
      allow delete: if isMe(uid) || isCreator();
    }

    // Photos live here, shrunk to fit free storage.
    match /profileImages/{uid} {
      allow read: if authed();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['avatar','banner','updatedAt'])
        && str(request.resource.data.get('avatar',''), 150000)
        && str(request.resource.data.get('banner',''), 240000);
      allow delete: if isMe(uid) || isCreator();
    }

    match /posts/{id} {
      allow read: if authed();
      allow create: if authed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','thumb','sticker','text','mood','kind','days','createdAt','cheers','reports'])
        && str(request.resource.data.name, 30)
        && str(request.resource.data.text, 200) && request.resource.data.text.size() >= 1
        && str(request.resource.data.thumb, 8000)
        && str(request.resource.data.sticker, 8)
        && str(request.resource.data.mood, 12)
        && request.resource.data.kind in ['status','streak']
        && request.resource.data.cheers.size() == 0
        && request.resource.data.reports.size() == 0
        && request.resource.data.createdAt == request.time;
      // Anyone signed in may only touch THEIR OWN key inside cheers / reports.
      allow update: if authed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheers','reports'])
        && (!('cheers' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.cheers.diff(resource.data.cheers).affectedKeys().hasOnly([request.auth.uid])
                && request.resource.data.cheers.get(request.auth.uid, 'x') is string
                && str(request.resource.data.cheers.get(request.auth.uid, 'x'), 12)))
        && (!('reports' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.reports.diff(resource.data.reports).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if authed() && (resource.data.uid == request.auth.uid || isCreator());
    }
  }
}
