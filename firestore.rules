rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------
    // FREE-TIER MODERATION (no Cloud Functions needed)
    //
    // Identity: every person has a permanent "key" = the uid of the FIRST account that was ever
    // registered with their verified Google email (emailOwners/{email}). Delete the account and sign
    // up again with the same email and you get the same key, so a ban follows the person.
    //
    // Strikes: strikes/{key}_1 and strikes/{key}_2 are two fixed "slots". Slot 2 can only be filled
    // by a DIFFERENT reporter than slot 1, and each strike must be written in the same batch as the
    // matching status/{key} change and the hiding of the reported message. The rules therefore count
    // distinct reporters without a server:   status.level 1 = warned,  level 2 = banned.
    // ---------------------------------------------------------------------------

    function authed() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function hasMember() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }
    function myKey() { return me().firstUid; }

    function isBanned(key) {
      return exists(/databases/$(database)/documents/status/$(key))
        && get(/databases/$(database)/documents/status/$(key)).data.level >= 2;
    }
    function canChat() {
      return authed() && hasMember()
        && me().email == request.auth.token.email
        && !isBanned(myKey());
    }

    // ---- who I am -----------------------------------------------------------------
    match /emailOwners/{email} {
      allow get: if authed() && email == request.auth.token.email;
      allow create: if authed() && email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.firstUid == request.auth.uid;
      allow list, update, delete: if false;
    }

    match /members/{uid} {
      allow get: if authed() && request.auth.uid == uid;
      allow create: if authed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'firstUid', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && (
          // first account ever for this email: I become the key owner (written in the same batch)
          (!exists(/databases/$(database)/documents/emailOwners/$(request.auth.token.email))
            && request.resource.data.firstUid == uid
            && existsAfter(/databases/$(database)/documents/emailOwners/$(request.auth.token.email))
            && getAfter(/databases/$(database)/documents/emailOwners/$(request.auth.token.email)).data.uid == uid)
          ||
          // returning person with a new account: inherit the original key (and any ban with it)
          (exists(/databases/$(database)/documents/emailOwners/$(request.auth.token.email))
            && request.resource.data.firstUid == get(/databases/$(database)/documents/emailOwners/$(request.auth.token.email)).data.uid)
        );
      allow list, update, delete: if false;
    }

    // ---- chat ---------------------------------------------------------------------
    match /lobby/{msgId} {
      allow read: if canChat();
      allow create: if canChat()
        && request.resource.data.keys().hasOnly(['uid', 'key', 'nickname', 'text', 'createdAt', 'bubble'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.key == myKey()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 400
        && (!('bubble' in request.resource.data) || (request.resource.data.bubble is string && request.resource.data.bubble.matches('^#[0-9A-Fa-f]{6}$')))
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.createdAt == request.time;
      // The only allowed edit: a reporter hides the message they just reported (same batch as the strike).
      allow update: if canChat()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
        && request.resource.data.hidden == true
        && (
          (existsAfter(/databases/$(database)/documents/strikes/$(resource.data.key + '_1'))
            && getAfter(/databases/$(database)/documents/strikes/$(resource.data.key + '_1')).data.messageId == msgId
            && getAfter(/databases/$(database)/documents/strikes/$(resource.data.key + '_1')).data.reporterKey == myKey())
          ||
          (existsAfter(/databases/$(database)/documents/strikes/$(resource.data.key + '_2'))
            && getAfter(/databases/$(database)/documents/strikes/$(resource.data.key + '_2')).data.messageId == msgId
            && getAfter(/databases/$(database)/documents/strikes/$(resource.data.key + '_2')).data.reporterKey == myKey())
        );
      allow delete: if false;
    }

    match /presence/{uid} {
      allow read: if canChat();
      allow write: if canChat() && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 20;
    }

    // ---- moderation ---------------------------------------------------------------
    // Readable only by the person it is about (so the app can show a warning / ban screen).
    match /status/{key} {
      allow get: if authed() && hasMember() && key == myKey();
      allow create: if canChat()
        && request.resource.data.keys().hasOnly(['level'])
        && request.resource.data.level == 1
        && existsAfter(/databases/$(database)/documents/strikes/$(key + '_1'))
        && getAfter(/databases/$(database)/documents/strikes/$(key + '_1')).data.reporterKey == myKey();
      allow update: if canChat()
        && resource.data.level == 1
        && request.resource.data.keys().hasOnly(['level'])
        && request.resource.data.level == 2
        && existsAfter(/databases/$(database)/documents/strikes/$(key + '_2'))
        && getAfter(/databases/$(database)/documents/strikes/$(key + '_2')).data.reporterKey == myKey();
      allow list, delete: if false;
    }

    // Write-only for users (nobody can read who reported whom).
    match /strikes/{id} {
      allow create: if canChat()
        && request.resource.data.keys().hasOnly(['targetKey', 'reporterKey', 'messageId', 'reason', 'createdAt'])
        && request.resource.data.reporterKey == myKey()
        && request.resource.data.targetKey is string
        && request.resource.data.targetKey != myKey()
        && request.resource.data.createdAt == request.time
        && request.resource.data.reason in ['harassment', 'hate', 'sexual', 'threats', 'spam', 'other']
        // the reported message must really exist and belong to the person being reported
        && get(/databases/$(database)/documents/lobby/$(request.resource.data.messageId)).data.key == request.resource.data.targetKey
        && (
          // 1st strike = warning: must be written together with status level 1
          (id == request.resource.data.targetKey + '_1'
            && existsAfter(/databases/$(database)/documents/status/$(request.resource.data.targetKey))
            && getAfter(/databases/$(database)/documents/status/$(request.resource.data.targetKey)).data.level == 1)
          ||
          // 2nd strike = ban: slot 1 must exist and come from a DIFFERENT person
          (id == request.resource.data.targetKey + '_2'
            && exists(/databases/$(database)/documents/strikes/$(request.resource.data.targetKey + '_1'))
            && get(/databases/$(database)/documents/strikes/$(request.resource.data.targetKey + '_1')).data.reporterKey != myKey()
            && existsAfter(/databases/$(database)/documents/status/$(request.resource.data.targetKey))
            && getAfter(/databases/$(database)/documents/status/$(request.resource.data.targetKey)).data.level == 2)
        );
      allow read, update, delete: if false;
    }
  }
}
